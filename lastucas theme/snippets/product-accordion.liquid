{%- comment %}
  Product Accordion - Description / Shipping 两组手风琴
  参数：product、shipping_text（可编辑文案，来自 section settings）
  注：Specifications 组已移除（2026-10-16）——参数规格统一在下方 A+ 详情区维护，避免重复
{%- endcomment -%}
{%- assign p = product -%}
<div class="product-accordion">
  {%- if p.description != blank -%}
    <details class="product-accordion__item" open>
      <summary class="product-accordion__summary">Description <span class="icon" aria-hidden="true">+</span></summary>
      <div class="product-accordion__content">{{ p.description }}</div>
    </details>
  {%- endif -%}

  <details class="product-accordion__item"{% unless p.description != blank %} open{% endunless %}>
    <summary class="product-accordion__summary">Shipping &amp; Returns <span class="icon" aria-hidden="true">+</span></summary>
    <div class="product-accordion__content">
      <p>{{ shipping_text | escape | newline_to_br }}</p>
    </div>
  </details>
</div>
