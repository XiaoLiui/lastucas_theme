{% comment %}
  Trust Bar - 顶部白色信任条
  Free shipping / Free returns / 1 year warranty
{% endcomment %}
<div class="trust-bar">
  <div class="trust-bar__inner container">
    {% for block in section.blocks %}
      <div class="trust-bar__item">
        <span class="trust-bar__dot">✓</span>
        <span>{{ block.settings.text | escape }}</span>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Trust Bar",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Bar",
      "blocks": [
        { "type": "item", "settings": { "text": "Free shipping" } },
        { "type": "item", "settings": { "text": "Free returns" } },
        { "type": "item", "settings": { "text": "1 year warranty" } }
      ]
    }
  ]
}
{% endschema %}
