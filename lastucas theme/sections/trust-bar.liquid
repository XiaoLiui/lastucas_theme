{% comment %}
  Trust Bar - 顶部信任条（4 项承诺）
  Free U.S. shipping / 30-day returns / 2-year warranty / U.S. warehouse
{% endcomment %}
<div class="trust-bar">
  <div class="trust-bar__inner container">
    {% for block in section.blocks %}
      <div class="trust-bar__item">
        <span class="trust-bar__dot">✓</span>
        <span>{{ block.settings.text | escape }}</span>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Trust Bar",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free U.S. Shipping Over $150" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Bar",
      "blocks": [
        { "type": "item", "settings": { "text": "Free U.S. Shipping Over $150" } },
        { "type": "item", "settings": { "text": "30-Day Easy Returns" } },
        { "type": "item", "settings": { "text": "2-Year Warranty" } },
        { "type": "item", "settings": { "text": "Ships from U.S. Warehouse" } }
      ]
    }
  ]
}
{% endschema %}
