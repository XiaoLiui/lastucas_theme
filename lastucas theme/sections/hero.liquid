{% comment %}
  Hero Slideshow - 全屏背景图 + 右下文案 + 左右箭头
  对应截图：整图背景，右下角 "COMFORT IN EVERY GLOW"
{% endcomment %}
<section class="hero" data-hero>
  <div class="hero__slides">
    {% for block in section.blocks %}
      <div class="hero__slide {% if forloop.first %}is-active{% endif %}" data-slide="{{ forloop.index0 }}">
        {% if block.settings.image != blank %}
          <img
            src="{{ block.settings.image | image_url: width: 2000 }}"
            alt="{{ block.settings.title | escape }}"
            class="hero__bg"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
          >
        {% else %}
          <img
            src="{{ 'hero-default.jpg' | asset_url }}"
            alt="{{ block.settings.title | escape }}"
            class="hero__bg"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
          >
        {% endif %}
      </div>
    {% endfor %}
  </div>

  {% if section.blocks.size > 1 %}
    <button class="hero__arrow hero__arrow--prev" aria-label="Previous slide" data-arrow="prev">‹</button>
    <button class="hero__arrow hero__arrow--next" aria-label="Next slide" data-arrow="next">›</button>
    <div class="hero__dots" data-dots>
      {% for block in section.blocks %}
        <span class="hero__dot {% if forloop.first %}is-active{% endif %}" data-dot="{{ forloop.index0 }}"></span>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Hero Slideshow",
  "max_blocks": 5,
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background image" },
        { "type": "text", "id": "title", "label": "Title", "default": "COMFORT IN EVERY GLOW" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slideshow",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
