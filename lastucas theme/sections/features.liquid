{% comment %}
  Features - WHY LASTUCAS?
  左文右图布局 + 2x3 手绘线稿图标
{% endcomment %}
<section class="why">
  <div class="container">
    <div class="why__top">
      <div class="why__text">
        <h2 class="why__title">{{ section.settings.title | escape | newline_to_br }}</h2>
        <p class="why__desc">{{ section.settings.desc | escape }}</p>
      </div>
      <div class="why__media">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | image_url: width: 900 }}" alt="LASTUCAS lamp" class="why__img">
        {% else %}
          <div class="why__img why__img--placeholder">Product image</div>
        {% endif %}
      </div>
    </div>

    <div class="why__grid">
      {% for block in section.blocks %}
        <div class="why-item">
          <div class="why-item__icon">
            {% case block.settings.icon %}
              {% when 'lamp' %}
                <svg viewBox="0 0 80 80" fill="none" stroke="#C7A05C" stroke-width="2"><path d="M40 15v40M40 15c-8 0-12 5-12 10h24c0-5-4-10-12-10z"/><circle cx="40" cy="12" r="4" fill="#C7A05C" stroke="none"/><path d="M25 65h30M30 65l5-10M50 65l-5-10"/></svg>
              {% when 'truck' %}
                <svg viewBox="0 0 80 80" fill="none" stroke="#C7A05C" stroke-width="2"><rect x="15" y="25" width="35" height="30"/><path d="M50 35h12l6 10v10H50z"/><circle cx="25" cy="60" r="6" fill="#C7A05C" stroke="none"/><circle cx="58" cy="60" r="5"/></svg>
              {% when 'star' %}
                <svg viewBox="0 0 80 80" fill="none" stroke="#C7A05C" stroke-width="2"><path d="M40 20l6 12 13 2-9 10 2 14-12-6-12 6 2-14-9-10 13-2z" fill="#C7A05C" stroke="none"/><path d="M20 30l3 6-6 1 5 4-2 7 6-4 6 4-2-7 5-4-6-1 3-6z"/><path d="M60 25l2 4 4 1-3 3 1 4-4-2-4 2 1-4-3-3 4-1z"/></svg>
              {% when 'shield' %}
                <svg viewBox="0 0 80 80" fill="none" stroke="#C7A05C" stroke-width="2"><path d="M40 15l20 7v15c0 15-10 25-20 30-10-5-20-15-20-30V22z"/><path d="M30 40l8 8 14-14" stroke="#C7A05C" stroke-width="3"/></svg>
              {% when 'return' %}
                <svg viewBox="0 0 80 80" fill="none" stroke="#C7A05C" stroke-width="2"><path d="M20 30h40v30H20z"/><path d="M20 30l10-10h20l10 10"/><path d="M30 45h20M30 52h12"/><circle cx="40" cy="65" r="5" fill="#C7A05C" stroke="none"/></svg>
              {% when 'bulb' %}
                <svg viewBox="0 0 80 80" fill="none" stroke="#C7A05C" stroke-width="2"><path d="M30 50c-5-5-8-10-8-16 0-11 9-20 20-20s20 9 20 20c0 6-3 11-8 16v10H30z"/><path d="M32 65h16M35 72h10"/><circle cx="42" cy="30" r="6" fill="#C7A05C" stroke="none"/></svg>
            {% endcase %}
          </div>
          <div class="why-item__text">
            <h4>{{ block.settings.title | escape }}</h4>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Lastucas",
  "max_blocks": 6,
  "settings": [
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "WHY\nLASTUCAS?"
    },
    {
      "type": "textarea",
      "id": "desc",
      "label": "Description",
      "default": "Solid walnut, brushed brass, and warm 2700K light. Every LASTUCAS lamp is made to be lived with — and loved — for years."
    },
    { "type": "image_picker", "id": "image", "label": "Right side image" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "lamp", "label": "Lamp" },
            { "value": "truck", "label": "Delivery truck" },
            { "value": "star", "label": "Star" },
            { "value": "shield", "label": "Shield" },
            { "value": "return", "label": "Return" },
            { "value": "bulb", "label": "Bulb" }
          ],
          "default": "lamp"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Solid Walnut & Brass" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Lastucas",
      "blocks": [
        { "type": "feature", "settings": { "icon": "lamp", "title": "Solid Walnut & Brass" } },
        { "type": "feature", "settings": { "icon": "truck", "title": "Free U.S. Shipping Over $150" } },
        { "type": "feature", "settings": { "icon": "star", "title": "Rated 4.8 by 1,200+ Homes" } },
        { "type": "feature", "settings": { "icon": "shield", "title": "2-Year Warranty" } },
        { "type": "feature", "settings": { "icon": "return", "title": "30-Day Easy Returns" } },
        { "type": "feature", "settings": { "icon": "bulb", "title": "Dimmable Warm Light" } }
      ]
    }
  ]
}
{% endschema %}
