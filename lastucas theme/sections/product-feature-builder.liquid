{% comment %}
  Product Feature Builder - 产品页长内容自由拼装模块
  目的：让不同产品拥有不同的长页面布局（对应竞品"同一店铺不同产品不同页面"的效果）
  原理：本 section 由多个 block 组成，每个 block 是一种内容块类型。
  商家在 Shopify 后台自定义编辑器里，可以给每个产品增删、排序这些 block，
  从而拼出千变万化的产品详情长页。内容文字/图片走 section 本地设置 + 产品 metafield 兜底。

  支持的 block 类型：
  - scene_gallery    场景图集（图 + 文案，多张可切换）
  - media_text       交替图文（左图右文 / 右图左文）
  - icon_features    特性图标条（图标 + 标题 + 描述）
  - specs_table      规格参数表（键值对）
  - faq              常见问题（折叠）
  - testimonial      买家秀 / 评价引用
  - image_banner     全宽大图
{% endcomment %}

{% if section.blocks.size > 0 %}
<section class="pfb" data-pfb>
  <div class="container">

    {% for block in section.blocks %}
      {% case block.type %}

        {% comment %} ============ 场景图集（可切换的图文组） ============ {% endcomment %}
        {% when 'scene_gallery' %}
          <div class="pfb__scene" data-pfb-scene {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}
              <h2 class="pfb__heading">{{ block.settings.heading | escape }}</h2>
            {% endif %}

            {% comment %} 图集项：从 block 设置里读多组图片（最多 4 组，每组 图+标题+文案） {% endcomment %}
            {% assign scene_items = '' %}
            <div class="pfb__scene-tabs" role="tablist">
              {% for i in (1..4) %}
                {%- capture img_key -%}scene_img{{ i }}{%- endcapture -%}
                {%- capture label_key -%}scene_label{{ i }}{%- endcapture -%}
                {%- if block.settings[img_key] != blank -%}
                  <button type="button" class="pfb__scene-tab {% if forloop.first %}is-active{% endif %}"
                          role="tab" data-scene-tab="{{ forloop.index0 }}"
                          {% if block.settings[label_key] != blank %}aria-label="{{ block.settings[label_key] | escape }}"{% endif %}>
                    {{ block.settings[label_key] | default: forloop.index }}
                  </button>
                {%- endif -%}
              {% endfor %}
            </div>

            <div class="pfb__scene-panels">
              {% for i in (1..4) %}
                {%- capture img_key -%}scene_img{{ i }}{%- endcapture -%}
                {%- capture text_key -%}scene_text{{ i }}{%- endcapture -%}
                {%- capture label_key -%}scene_label{{ i }}{%- endcapture -%}
                {%- if block.settings[img_key] != blank -%}
                  <div class="pfb__scene-panel {% if forloop.first %}is-active{% endif %}" role="tabpanel" data-scene-panel="{{ forloop.index0 }}">
                    <div class="pfb__scene-media">
                      <img src="{{ block.settings[img_key] | image_url: width: 1600 }}"
                           alt="{{ block.settings[label_key] | escape }}"
                           loading="lazy" width="1600" height="1000">
                    </div>
                    {% if block.settings[text_key] != blank %}
                      <div class="pfb__scene-text">{{ block.settings[text_key] | escape }}</div>
                    {% endif %}
                  </div>
                {%- endif -%}
              {% endfor %}
            </div>
          </div>

        {% comment %} ============ 交替图文（左图右文 / 右图左文） ============ {% endcomment %}
        {% when 'media_text' %}
          <div class="pfb__media-text{% if block.settings.flip %} pfb__media-text--flip{% endif %}" {{ block.shopify_attributes }}>
            <div class="pfb__media-text-media">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 1200 }}"
                     alt="{{ block.settings.title | escape }}"
                     loading="lazy" width="1200" height="800">
              {% endif %}
            </div>
            <div class="pfb__media-text-body">
              {% if block.settings.eyebrow != blank %}
                <span class="pfb__eyebrow">{{ block.settings.eyebrow | escape }}</span>
              {% endif %}
              {% if block.settings.title != blank %}
                <h3 class="pfb__title">{{ block.settings.title | escape }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="pfb__text">{{ block.settings.text }}</div>
              {% endif %}
            </div>
          </div>

        {% comment %} ============ 特性图标条 ============ {% endcomment %}
        {% when 'icon_features' %}
          <div class="pfb__icons" {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}
              <h2 class="pfb__heading">{{ block.settings.heading | escape }}</h2>
            {% endif %}
            <div class="pfb__icons-grid">
              {% for i in (1..4) %}
                {%- capture icon_key -%}icon{{ i }}{%- endcapture -%}
                {%- capture title_key -%}title{{ i }}{%- endcapture -%}
                {%- capture text_key -%}text{{ i }}{%- endcapture -%}
                {%- if block.settings[title_key] != blank -%}
                  <div class="pfb__icon-item">
                    {% if block.settings[icon_key] != blank %}
                      <span class="pfb__icon"><img src="{{ block.settings[icon_key] | image_url: width: 120 }}" alt="" loading="lazy"></span>
                    {% endif %}
                    <span class="pfb__icon-title">{{ block.settings[title_key] | escape }}</span>
                    {% if block.settings[text_key] != blank %}
                      <span class="pfb__icon-text">{{ block.settings[text_key] | escape }}</span>
                    {% endif %}
                  </div>
                {%- endif -%}
              {% endfor %}
            </div>
          </div>

        {% comment %} ============ 规格参数表（键值对） ============ {% endcomment %}
        {% when 'specs_table' %}
          <div class="pfb__specs" {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}
              <h2 class="pfb__heading">{{ block.settings.heading | escape }}</h2>
            {% endif %}
            <table class="pfb__specs-table">
              <tbody>
                {% for i in (1..10) %}
                  {%- capture key_key -%}row{{ i }}_key{%- endcapture -%}
                  {%- capture val_key -%}row{{ i }}_val{%- endcapture -%}
                  {%- if block.settings[key_key] != blank -%}
                    <tr>
                      <th>{{ block.settings[key_key] | escape }}</th>
                      <td>{{ block.settings[val_key] | escape }}</td>
                    </tr>
                  {%- endif -%}
                {% endfor %}
              </tbody>
            </table>
          </div>

        {% comment %} ============ 常见问题（折叠） ============ {% endcomment %}
        {% when 'faq' %}
          <div class="pfb__faq" {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}
              <h2 class="pfb__heading">{{ block.settings.heading | escape }}</h2>
            {% endif %}
            {% for i in (1..6) %}
              {%- capture q_key -%}q{{ i }}{%- endcapture -%}
              {%- capture a_key -%}a{{ i }}{%- endcapture -%}
              {%- if block.settings[q_key] != blank -%}
                <details class="pfb__faq-item">
                  <summary class="pfb__faq-q">{{ block.settings[q_key] | escape }}</summary>
                  <div class="pfb__faq-a">{{ block.settings[a_key] }}</div>
                </details>
              {%- endif -%}
            {% endfor %}
          </div>

        {% comment %} ============ 买家秀 / 评价引用 ============ {% endcomment %}
        {% when 'testimonial' %}
          <div class="pfb__quote" {{ block.shopify_attributes }}>
            {% if block.settings.quote != blank %}
              <blockquote class="pfb__quote-text">{{ block.settings.quote | escape }}</blockquote>
            {% endif %}
            {% if block.settings.author != blank %}
              <cite class="pfb__quote-author">{{ block.settings.author | escape }}</cite>
            {% endif %}
          </div>

        {% comment %} ============ 全宽大图 ============ {% endcomment %}
        {% when 'image_banner' %}
          <div class="pfb__banner" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 2000 }}"
                   alt="{{ block.settings.title | escape }}"
                   loading="lazy" width="2000" height="800">
            {% endif %}
          </div>

      {% endcase %}
    {% endfor %}

  </div>
</section>

{% comment %} 场景图集切换 JS {% endcomment %}
<script>
  (function () {
    'use strict';
    document.querySelectorAll('[data-pfb-scene]').forEach(function (scene) {
      var tabs = scene.querySelectorAll('[data-scene-tab]');
      var panels = scene.querySelectorAll('[data-scene-panel]');
      if (!tabs.length || !panels.length) return;
      function activate(idx) {
        tabs.forEach(function (t) {
          t.classList.toggle('is-active', t.getAttribute('data-scene-tab') == String(idx));
        });
        panels.forEach(function (p) {
          p.classList.toggle('is-active', p.getAttribute('data-scene-panel') == String(idx));
        });
      }
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          activate(Number(tab.getAttribute('data-scene-tab')));
        });
      });
    });
  })();
</script>
{% endif %}

