{% comment %}
  Order Protection - 直购保障区（内容写死，品牌 LASTUCAS）
  开关：产品元字段 custom.order_protection（布尔值）为 true 时渲染，否则不输出任何标签
{% endcomment %}

{%- assign order_protection = product.metafields.custom.order_protection.value -%}

{%- if order_protection == true -%}
<section class="order-protection">
  <div class="container">
    <h2 class="order-protection__heading">Order Direct. Get More Protection.</h2>
    <p class="order-protection__sub">When you purchase from LASTUCAS.com, you're getting more than just a lamp. You're getting peace of mind and premium service.</p>

    <div class="order-protection__grid">
      <div class="order-protection__card">
        <span class="order-protection__icon">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l1-5h16l1 5"/><path d="M4 9v11h16V9"/><path d="M9 20v-6h6v6"/><path d="M3 9c0 1.7 1.6 3 3.5 3S10 10.7 10 9c0 1.7 1.6 3 3.5 3S17 10.7 17 9c0 1.7 1.6 3 3.5 3S22 10.7 22 9"/></svg>
        </span>
        <span class="order-protection__title">Official LASTUCAS Store</span>
        <span class="order-protection__text">Authentic products, guaranteed</span>
      </div>

      <div class="order-protection__card">
        <span class="order-protection__icon">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.4-3 8.4-7 10-4-1.6-7-5.6-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>
        </span>
        <span class="order-protection__title">2-Year Warranty</span>
        <span class="order-protection__text">Official LASTUCAS.com coverage</span>
      </div>

      <div class="order-protection__card">
        <span class="order-protection__icon">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4"/><circle cx="12" cy="16" r="0.5" fill="currentColor"/></svg>
        </span>
        <span class="order-protection__title">Direct Support</span>
        <span class="order-protection__text">Priority customer service</span>
      </div>

      <div class="order-protection__card">
        <span class="order-protection__icon">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
        </span>
        <span class="order-protection__title">Fast Processing</span>
        <span class="order-protection__text">Ships within 24 hours</span>
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Order Protection",
  "tag": "section",
  "class": "section-order-protection",
  "settings": [
    {
      "type": "paragraph",
      "content": "产品元字段 custom.order_protection（布尔值）为 true 时显示本区块，内容固定为 LASTUCAS 品牌保障文案。"
    }
  ],
  "presets": [
    { "name": "Order Protection" }
  ]
}
{% endschema %}
