{% comment %}
  Product Detail Sections - 产品长内容（Metafield 驱动版）
  目的：让每个产品在 Shopify 后台各自维护长页内容，页面结构相同但数据随产品变。
  数据来源（全部为产品元字段，产品未填的模块自动隐藏）：
  1. custom.icon_features  → Metaobject 列表（type: icon_feature）
     字段：icon（文件）/ title（单行文本）/ text（多行文本）
  2. custom.content_blocks → Metaobject 列表（type: content_block）
     字段：image（文件）/ eyebrow（单行）/ title（单行）/ text（富文本）/ flip（真假值，图文对调）
  3. custom.specifications → JSON（键值对对象）
  4. custom.faq            → Metaobject 列表（type: faq_item）
     字段：question（单行文本）/ answer（富文本）
  5. custom.reviews        → Metaobject 列表（type: review_item）
     字段：image（文件）/ rating（整数 1-5）/ text（多行文本）/ author（单行文本）

  后台配置方法见主题说明（Metaobject 定义：icon_feature、content_block、faq_item、review_item）。
{% endcomment %}

{%- liquid
  # 图标条：兼容单复数两种键名（icon_features / icon_feature）
  assign icon_features = product.metafields.custom.icon_features.value
  if icon_features == blank
    assign icon_features = product.metafields.custom.icon_feature.value
  endif
  # 交替图文：兼容单复数两种键名（content_blocks / content_block）
  assign content_blocks = product.metafields.custom.content_blocks.value
  if content_blocks == blank
    assign content_blocks = product.metafields.custom.content_block.value
  endif
  assign specs = product.metafields.custom.specifications.value
  assign faqs = product.metafields.custom.faq.value
  # 买家秀：兼容单复数（reviews / review）
  assign reviews = product.metafields.custom.reviews.value
  if reviews == blank
    assign reviews = product.metafields.custom.review.value
  endif

  assign has_icons = false
  if icon_features != blank and icon_features.size > 0
    assign has_icons = true
  endif
  assign has_blocks = false
  if content_blocks != blank and content_blocks.size > 0
    assign has_blocks = true
  endif
  assign has_specs = false
  if specs != blank
    assign has_specs = true
  endif
  assign has_faqs = false
  if faqs != blank and faqs.size > 0
    assign has_faqs = true
  endif
  assign has_reviews = false
  if reviews != blank and reviews.size > 0
    assign has_reviews = true
  endif
-%}

{%- if has_blocks or has_specs or has_faqs or has_reviews -%}
<section class="pfb pfb--metafield" data-pfb-metafield>
  <div class="container">

    {%- comment %} 图标条已移至 main-product.liquid（TECHNICAL DETAILS 下方），此处不再渲染 {% endcomment -%}

    {%- comment %} ============ 交替图文（按 metaobject 顺序渲染）
      规则：有图片 → 图文块；无图片但有正文 → 图文块(编辑模式显示占位符)；无图片且无正文仅有标题 → 居中章节大标题 {% endcomment -%}
    {%- if has_blocks -%}
      {%- for cb in content_blocks -%}
        {%- assign cb_img = cb.image.value -%}
        {%- assign cb_flip = cb.flip.value -%}
        {%- if cb_img != blank -%}
          <div class="pfb__media-text{% if cb_flip %} pfb__media-text--flip{% endif %}">
            <div class="pfb__media-text-media">
              <img src="{{ cb_img | image_url: width: 1200 }}"
                   alt="{{ cb.title.value | escape }}"
                   loading="lazy" width="1200" height="800">
            </div>
            <div class="pfb__media-text-body">
              {%- if cb.eyebrow.value != blank -%}
                <span class="pfb__eyebrow">{{ cb.eyebrow.value | escape }}</span>
              {%- endif -%}
              {%- if cb.title.value != blank -%}
                <h3 class="pfb__title">{{ cb.title.value | escape }}</h3>
              {%- endif -%}
              {%- if cb.text.value != blank -%}
                <div class="pfb__text">{{ cb.text | metafield_tag }}</div>
              {%- endif -%}
            </div>
          </div>
        {%- elsif cb.text.value != blank -%}
          {%- comment %} 有正文但没传图：编辑模式显示占位符，前台只渲染文字（照片上传后自动补位） {% endcomment -%}
          <div class="pfb__media-text{% if cb_flip %} pfb__media-text--flip{% endif %}">
            {%- if request.design_mode -%}
              <div class="pfb__media-text-media">
                {{ 'product-1' | placeholder_svg_tag: 'pfb__placeholder' }}
              </div>
            {%- endif -%}
            <div class="pfb__media-text-body">
              {%- if cb.eyebrow.value != blank -%}
                <span class="pfb__eyebrow">{{ cb.eyebrow.value | escape }}</span>
              {%- endif -%}
              {%- if cb.title.value != blank -%}
                <h3 class="pfb__title">{{ cb.title.value | escape }}</h3>
              {%- endif -%}
              <div class="pfb__text">{{ cb.text | metafield_tag }}</div>
            </div>
          </div>
        {%- elsif cb.title.value != blank -%}
          <h2 class="pfb__heading">{{ cb.title.value | escape }}</h2>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {%- comment %} ============ 规格参数表（双栏卡片式，位于 FAQ 上方） ============ {% endcomment -%}
    {%- if has_specs -%}
      <div class="pfb__specs">
        <h2 class="pfb__heading">Specifications</h2>
        <div class="pfb__specs-grid">
          {%- for spec in specs -%}
            <div class="pfb__spec-row">
              <span class="pfb__spec-key">{{ spec[0] | escape }}</span>
              <span class="pfb__spec-val">{{ spec[1] | escape }}</span>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment %} ============ FAQ（折叠） ============ {% endcomment -%}
    {%- if has_faqs -%}
      <div class="pfb__faq">
        <h2 class="pfb__heading">Frequently Asked Questions</h2>
        {%- for item in faqs -%}
          <details class="pfb__faq-item">
            <summary class="pfb__faq-q">{{ item.question.value | escape }}</summary>
            {%- if item.answer.value != blank -%}
              <div class="pfb__faq-a">{{ item.answer | metafield_tag }}</div>
            {%- endif -%}
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment %} ============ Customer Highlights 买家秀（A+ 底部） ============ {% endcomment -%}
    {%- if has_reviews -%}
      <div class="pfb__reviews">
        <h2 class="pfb__heading">{{ section.settings.reviews_heading | default: 'Customer Highlights' | escape }}</h2>
        {%- if section.settings.reviews_sub != blank -%}
          <p class="reviews__sub">{{ section.settings.reviews_sub | escape }}</p>
        {%- endif -%}
        <div class="reviews-grid">
          {%- for r in reviews -%}
            <div class="review-card">
              <div class="review-card__media">
                {%- assign r_img = r.image.value -%}
                {%- if r_img != blank -%}
                  <img src="{{ r_img | image_url: width: 600 }}" alt="{{ r.author.value | escape }}" loading="lazy">
                {%- elsif request.design_mode -%}
                  {{ 'product-1' | placeholder_svg_tag: 'pfb__placeholder pfb__placeholder--square' }}
                {%- endif -%}
              </div>
              {%- assign rt = r.rating.value | default: 5 -%}
              <div class="review-card__stars" aria-label="{{ rt }} out of 5 stars">
                {%- for i in (1..5) -%}
                  {%- if i <= rt -%}<span class="is-on">★</span>{%- else -%}<span class="is-off">★</span>{%- endif -%}
                {%- endfor -%}
              </div>
              {%- if r.text.value != blank -%}
                <div class="review-card__text">{{ r.text.value | escape }}</div>
              {%- endif -%}
              {%- if r.author.value != blank -%}
                <span class="review-card__name">{{ r.author.value | escape }}</span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Metafield Sections",
  "tag": "section",
  "class": "section-pfb-metafield",
  "settings": [
    {
      "type": "paragraph",
      "content": "本区块内容全部来自产品元字段：custom.icon_features / custom.content_blocks / custom.specifications / custom.faq / custom.reviews。产品未填写时整个区块自动隐藏。"
    },
    {
      "type": "text",
      "id": "reviews_heading",
      "label": "买家秀标题",
      "default": "Customer Highlights"
    },
    {
      "type": "textarea",
      "id": "reviews_sub",
      "label": "买家秀副标题",
      "default": "Real-life setups from homes using LASTUCAS floor lamps for brighter, more flexible room lighting."
    }
  ],
  "presets": [
    { "name": "Metafield Sections" }
  ]
}
{% endschema %}
