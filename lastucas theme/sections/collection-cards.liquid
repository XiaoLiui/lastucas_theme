{% comment %}
  Collection Cards - 首页三个产品分类大卡片
  对应 sunmory: Arc Floor Lamp / Torchiere / with Shelves
{% endcomment %}
<section class="collection-cards container">
  <div class="collection-cards__grid">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link | default: '#' }}" class="collection-card">
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" class="collection-card__img">
        {% else %}
          <div class="collection-card__img collection-card__img--placeholder">{{ block.settings.title | escape }}</div>
        {% endif %}
        <div class="collection-card__overlay">
          <h3 class="collection-card__title">{{ block.settings.title | escape }}</h3>
          <span class="collection-card__cta">Shop now →</span>
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Collection Cards",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Arc Floor Lamp" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Cards",
      "blocks": [
        { "type": "card", "settings": { "title": "Arc Floor Lamp" } },
        { "type": "card", "settings": { "title": "Torchiere Floor Lamp" } },
        { "type": "card", "settings": { "title": "Floor Lamp with Shelves" } }
      ]
    }
  ]
}
{% endschema %}
