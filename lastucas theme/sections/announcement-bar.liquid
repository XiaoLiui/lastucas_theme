{% comment %}
  顶部公告条 - 对应截图的黄色横条
  可在 Customizer 里改文字、链接、背景色
{% endcomment %}
<div class="announcement-bar" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="announcement-bar__inner container">
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}" class="announcement-bar__link">
        {{ section.settings.text | escape }}
      </a>
    {% else %}
      <span>{{ section.settings.text | escape }}</span>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "Up To 50% Off and Free Shipping - Shop Now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FFD400"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    }
  ],
  "presets": [
    { "name": "Announcement Bar" }
  ]
}
{% endschema %}
