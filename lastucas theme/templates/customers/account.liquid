{% comment %} 账户首页（未登录会自动跳转到登录页） {% endcomment %}

{% section 'announcement-bar' %}
{% section 'header' %}

<section class="auth-page">
  <div class="container">
    <div class="auth-page__box">
      <h1 class="auth-page__title">My Account</h1>
      {% if customer %}
        <p>Welcome, {{ customer.first_name }}!</p>
        <p><a href="{{ routes.account_logout_url }}">Log out</a></p>
      {% else %}
        <p>Please <a href="{{ routes.account_login_url }}">sign in</a> to view your account.</p>
      {% endif %}
    </div>
  </div>
</section>

{% section 'footer' %}
