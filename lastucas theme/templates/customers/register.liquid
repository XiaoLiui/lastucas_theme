{% comment %} 注册页 {% endcomment %}

{% section 'announcement-bar' %}
{% section 'header' %}

<section class="auth-page">
  <div class="container">
    <div class="auth-page__box">
      <h1 class="auth-page__title">Create Account</h1>

      {% form 'create_customer' %}
        {{ form.errors }}

        <div class="auth-page__field">
          <label for="FirstName">First Name</label>
          <input type="text" id="FirstName" name="customer[first_name]" autofocus>
        </div>

        <div class="auth-page__field">
          <label for="LastName">Last Name</label>
          <input type="text" id="LastName" name="customer[last_name]">
        </div>

        <div class="auth-page__field">
          <label for="Email">Email</label>
          <input type="email" id="Email" name="customer[email]" autocorrect="off" autocapitalize="off">
        </div>

        <div class="auth-page__field">
          <label for="Password">Password</label>
          <input type="password" id="Password" name="customer[password]">
        </div>

        <div class="auth-page__actions">
          <button type="submit" class="auth-page__submit">Create</button>
        </div>
      {% endform %}

      <div class="auth-page__footer">
        <p>Already have an account? <a href="{{ routes.account_login_url }}" class="auth-page__link">Sign in</a></p>
      </div>
    </div>
  </div>
</section>

{% section 'footer' %}
